<Window x:Class="JX3Artist.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="剑网3 艺人助手" Width="960" Height="700" MinWidth="900" MinHeight="650" Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen" SizeChanged="RecordsLayoutChanged">
 <Window.Resources>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0.5"/><Setter Property="MinHeight" Value="42"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0.5" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter TargetName="Surface" Property="Opacity" Value="0.4"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="StartAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Ink}"/><Setter Property="Foreground" Value="{DynamicResource Paper}"/><Setter Property="BorderBrush" Value="{DynamicResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="StopAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource StopFill}"/><Setter Property="Foreground" Value="{DynamicResource StopInk}"/><Setter Property="BorderBrush" Value="{DynamicResource StopEdge}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0.5"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="36"/><Setter Property="BorderThickness" Value="0.5"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Foreground="{DynamicResource Ink}" Focusable="False" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0.5" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Grid><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="8,0,20,0"/><Viewbox Width="14" Height="14" HorizontalAlignment="Right"><Canvas Width="24" Height="24"><Path Data="M 6,9 L 12,15 L 18,9" Stroke="{DynamicResource Ink}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Grid></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0.5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ContextMenu"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0.5" CornerRadius="8" Padding="{TemplateBinding Padding}"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="MenuItem"><Setter Property="Padding" Value="12,9"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="MinHeight" Value="36"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="ItemSurface" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectedMark" Text="✓" Visibility="Hidden"/><ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Line}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="OptionSwitch" TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="MinHeight" Value="24"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/><Border x:Name="SwitchTrack" Grid.Column="1" Width="34" Height="20" CornerRadius="10" Margin="12,0,0,0" Background="{DynamicResource Line}"><Ellipse x:Name="SwitchThumb" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="{DynamicResource Paper}"><Ellipse.RenderTransform><TranslateTransform x:Name="ThumbOffset"/></Ellipse.RenderTransform></Ellipse></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource Accent}"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X" To="14" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="14,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,0,6,0"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Surface}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True" Margin="4,0,0,10"/><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid x:Name="ApplicationRoot" Background="{DynamicResource Paper}"><Grid Margin="30,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ClientMenuButton" Content="旗舰端 · 单开　⌄" Click="ClientMenuClicked" Padding="12,8" MinHeight="36"/><Button x:Name="SkinMenuButton" Content="幕间　⌄" Click="SkinMenuClicked" Padding="12,8" MinHeight="36"/><Button x:Name="SettingsMenuButton" Content="☰" Click="ApplicationMenuClicked" Padding="12,8" MinHeight="36" Margin="0"/><CheckBox x:Name="RemindAgain" Visibility="Collapsed" Content="开始前提醒" Checked="ReminderChanged" Unchecked="ReminderChanged"/></StackPanel><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource Accent}" Width="34" Height="34" CornerRadius="10" Margin="0,0,12,0"><Viewbox Margin="6"><Canvas Width="30" Height="30"><Path Data="M 7,25 C 8,15 23,15 24,3 M 5,8 C 5,16 22,15 24,26" Stroke="{DynamicResource Paper}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border><TextBlock Text="艺人助手" FontFamily="SimSun" FontSize="28" VerticalAlignment="Center"/></StackPanel></DockPanel>
  <Border x:Name="TakeoverNotice" Visibility="Collapsed" Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0.5,0,0.5" Padding="0,12"><TextBlock Text="续演时会切换游戏并移动鼠标，接管期间请暂缓操作。" Foreground="{DynamicResource Muted}"/></Border>
  <Grid x:Name="MainPanel" Grid.Row="2" Margin="0,30" VerticalAlignment="Center">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="PlanCaption" Text="本次计划"/>
   <TextBlock x:Name="CountdownCaption" Grid.Column="2" Text="本轮预计剩余"/>
   <StackPanel x:Name="PlanControls" Grid.Row="1"><ComboBox x:Name="CycleLimit" SelectionChanged="PlanChanged" SelectedIndex="2" Margin="0,16,0,10"><ComboBoxItem Content="1次" Tag="1"/><ComboBoxItem Content="2次" Tag="2"/><ComboBoxItem Content="3次" Tag="3"/><ComboBoxItem Content="自定义次数" Tag="custom"/><ComboBoxItem Content="持续运行，直到手动停止" Tag="0"/></ComboBox><TextBox x:Name="CustomLimit" Text="5" Padding="8" Margin="0,0,0,16" ToolTip="自定义正整数次数"/></StackPanel>
   <Border x:Name="StateBadge" Grid.Row="1" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock x:Name="StateTitle"/></Border>
   <StackPanel x:Name="CountsBlock" Grid.Row="2" VerticalAlignment="Bottom"><TextBlock x:Name="CountsCaption" Text="助手已自动开始" Visibility="Collapsed" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/><TextBlock x:Name="Counts" Text="助手自动开始：0 次" FontSize="14" Foreground="{DynamicResource Muted}"/></StackPanel>
   <TextBlock x:Name="CountdownNote" Grid.Row="2" Grid.Column="2" Text="等待开始" FontSize="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" TextWrapping="Wrap"/>

   <TextBlock x:Name="StateMessage" Grid.Row="3" Grid.Column="2" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,12,0,18"/>
   <StackPanel x:Name="AutoBlock" Grid.Row="3" Margin="0,18,0,0"><ProgressBar x:Name="PlanProgress" Visibility="Collapsed" Height="5" Margin="0,0,0,16" Foreground="{DynamicResource Accent}" Background="{DynamicResource Surface}" BorderThickness="0"><ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/></Grid></ControlTemplate></ProgressBar.Template></ProgressBar><CheckBox x:Name="Unattended" Style="{StaticResource OptionSwitch}" Content="后续自动接管" Checked="UnattendedChanged" Unchecked="UnattendedChanged" ToolTip="可随时更改，立即影响后续自动接管"/><TextBlock x:Name="AutoTakeoverHint" Text="手动：表演结束后提醒，允许后才接管。" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>

   <StackPanel x:Name="ActionBlock" Grid.Row="4" Grid.Column="2" Margin="0,18,0,0"><TextBlock x:Name="NextCheckNote" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,10" Visibility="Collapsed"/><Button x:Name="ApproveButton" Style="{StaticResource StartAction}" Content="允许本次接管" Click="ApproveClicked" Visibility="Collapsed" Margin="0,0,0,10"/><WrapPanel><Button x:Name="StartButton" Style="{StaticResource StartAction}" Content="开始辅助" Click="StartClicked"/><Button x:Name="StopButton" Style="{StaticResource StopAction}" Content="停止辅助" Click="StopClicked" IsEnabled="False"/></WrapPanel><Button x:Name="HotkeySettingsButton" Visibility="Collapsed" Content="自定义快捷键" Click="HotkeysClicked" HorizontalAlignment="Left" MinHeight="28" Padding="0,4" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/><TextBlock x:Name="PermissionNote" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/><CheckBox x:Name="Prepared" Visibility="Collapsed"/></StackPanel>
   <StackPanel x:Name="ExperienceBlock" Grid.Row="4" Margin="0,18,16,0"><TextBlock Text="经验估算" Foreground="{DynamicResource Muted}"/><WrapPanel Margin="0,5,0,0"><TextBlock x:Name="ExperienceGain" Text="本次 +0" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="20" Margin="0,0,22,0"/><TextBlock x:Name="ExperienceTotal" Text="累计 +0" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="20"/></WrapPanel><TextBlock x:Name="ExperienceHint" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
   <Border x:Name="MainDivider" Grid.Column="1" Grid.RowSpan="5" BorderBrush="{DynamicResource Line}" BorderThickness="0.5,0,0,0" HorizontalAlignment="Center"/>
  </Grid>
  <StackPanel Grid.Row="3"><TextBlock x:Name="HealthNotice" Visibility="Collapsed" Foreground="{DynamicResource StopInk}" TextWrapping="Wrap" Margin="0,0,0,8"/><Expander x:Name="RecordsExpander" Header="画面与记录" Expanded="RecordsLayoutChanged" Collapsed="RecordsLayoutChanged" MaxHeight="230" Foreground="{DynamicResource Muted}">
   <Grid x:Name="RecordsContent" Margin="24,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PreviewHint" Text="等待新画面"/><Image x:Name="Preview" Height="128" HorizontalAlignment="Left" Stretch="Uniform" Visibility="Collapsed"/><TextBlock x:Name="FrameNote" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/><TextBlock x:Name="DiagnosticNote" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="RecordingNote" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Top"><Button x:Name="OpenRecordsButton" Content="打开软件记录" Click="LogsClicked" HorizontalAlignment="Right" VerticalAlignment="Top" MinHeight="32" Padding="12,6" Margin="24,0,0,0"/><Button x:Name="SupportButton" Content="导出问题报告" Click="SupportClicked" HorizontalAlignment="Right" MinHeight="32" Padding="12,6" Margin="24,0,0,8"/><TextBlock x:Name="ExperienceHistoryNote" TextWrapping="Wrap" MaxWidth="250" Foreground="{DynamicResource Muted}" Margin="24,0,0,8"/></StackPanel>
   </Grid>
  </Expander></StackPanel>
 </Grid><Image x:Name="CurtainImage" Visibility="Collapsed" IsHitTestVisible="False" Stretch="Fill"/>
 </Grid>
</Window>
